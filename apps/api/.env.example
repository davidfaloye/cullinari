# Runtime connection: the API connects as cullinari_app, which cannot bypass row-level security.
DATABASE_URL="postgresql://cullinari_app:app@localhost:5432/cullinari"
# Migrations and seed run as the schema owner.
MIGRATE_DATABASE_URL="postgresql://cullinari_owner:owner@localhost:5432/cullinari"

PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:5173"

# Sign admin sessions. Use a long random value in every real environment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_TTL="12h"

# 32-byte key, base64, used to encrypt each restaurant's Paystack secret key at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Protects /internal/* (manual onboarding until the staff console exists).
STAFF_API_KEY="change-me"

# Public base URL of this API, used for Paystack callback and webhook URLs.
PUBLIC_API_URL="http://localhost:4000"
