{
  "name": "cullinari",
  "private": true,
  "description": "Cullinari: restaurant admin platform, ordering app backend and staff console",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @cullinari/api dev",
    "dev:admin": "pnpm --filter @cullinari/admin dev",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @cullinari/api db:migrate",
    "db:seed": "pnpm --filter @cullinari/api db:seed",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
